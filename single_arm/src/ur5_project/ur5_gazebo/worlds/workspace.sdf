<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="ur5_workspace">

    <!-- 物理引擎 -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- 场景设置 -->
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- 太阳光 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 工作台 - 放在机械臂前方，地面上 -->
    <include>
      <uri>model://workspace_table</uri>
      <name>workspace_table</name>
      <pose>0.2 0 0.025 0 0 0</pose>
    </include>

    <!-- 红色方块 -->
    <include>
      <uri>model://red_block</uri>
      <name>red_block_1</name>
      <pose>0.2 -0.15 0.075 0 0 0</pose>
    </include>

    <include>
      <uri>model://red_block</uri>
      <name>red_block_2</name>
      <pose>0.2 -0.05 0.075 0 0 0</pose>
    </include>

    <!-- 绿色方块 -->
    <include>
      <uri>model://green_block</uri>
      <name>green_block_1</name>
      <pose>0.2 0.05 0.075 0 0 0</pose>
    </include>

    <include>
      <uri>model://green_block</uri>
      <name>green_block_2</name>
      <pose>0.2 0.15 0.075 0 0 0</pose>
    </include>

    <!-- 蓝色方块 -->
    <include>
      <uri>model://blue_block</uri>
      <name>blue_block_1</name>
      <pose>0.35 0.0 0.075 0 0 0</pose>
    </include>

    <!-- 码垛区域标记 -->
    <include>
      <uri>model://pallet_zone</uri>
      <name>pallet_zone1</name>
      <pose>-0.4 0.75 0.0 0 0 0</pose>
    </include>

    <!-- 码垛区域标记 -->
    <include>
      <uri>model://pallet_zone</uri>
      <name>pallet_zone2</name>
      <pose>-0.1 0.6 0.0 0 0 0</pose>
    </include>

    <!-- 码垛区域标记 -->
    <include>
      <uri>model://pallet_zone</uri>
      <name>pallet_zone3</name>
      <pose>-0.7 0.6 0.0 0 0 0</pose>
    </include>

  </world>
</sdf>
