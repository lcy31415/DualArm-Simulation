<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="ur5_dual_workspace">

    <!-- 物理引擎 -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- 场景 -->
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- 主光源 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 补光（改善俯视相机成像质量） -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.85 0.85 0.80 1</ambient>
            <diffuse>0.85 0.85 0.80 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      ══════════════════════════════════════════════════
      5 个工作物体  散落于 0.6×0.6 工作区
      工作区中心 (0,0,0)，x/y ∈ [-0.3, 0.3]
      ══════════════════════════════════════════════════
    -->

    <!-- ① 正方体  60mm 边长  橙色  link z=0.03 -->
    <model name="cube">
      <pose>-0.15 0.15 0 0 0 0.5</pose>
      <link name="link">
        <pose>0 0 0.03 0 0 0</pose>
        <inertial>
          <mass>0.151</mass>
          <inertia>
            <ixx>9.06e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>9.06e-05</iyy><iyz>0</iyz>
            <izz>9.06e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material>
            <ambient>0.85 0.45 0.10 1</ambient>
            <diffuse>0.90 0.55 0.15 1</diffuse>
            <specular>0.20 0.12 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ② 圆柱体  r=30mm h=80mm  蓝灰色  link z=0.04 -->
    <model name="cylinder">
      <pose>0.17 0.12 0 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.04 0 0 0</pose>
        <inertial>
          <mass>0.113</mass>
          <inertia>
            <ixx>8.57e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>8.57e-05</iyy><iyz>0</iyz>
            <izz>5.09e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.08</length></cylinder></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.08</length></cylinder></geometry>
          <material>
            <ambient>0.40 0.55 0.75 1</ambient>
            <diffuse>0.50 0.65 0.85 1</diffuse>
            <specular>0.60 0.65 0.70 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ③ RoboCup 足球  Ø80mm  model z=0.04 -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/RoboCup 3D Simulation Ball</uri>
      <name>robocup_ball</name>
      <pose>0.14 -0.16 0.04 0 0 0</pose>
    </include>

    <!-- ④ 圆环（柱形）  外径100mm 管径20mm  精细网格 -->
    <include>
      <uri>model://ring_torus</uri>
      <name>ring</name>
      <pose>-0.16 -0.13 0 0 0 0</pose>
    </include>

    <!-- ⑤ T型块  黄色  平躺  厚40mm -->
    <model name="t_block">
      <pose>-0.02 -0.06 0 0 0 0.8</pose>
      <link name="link">
        <inertial>
          <mass>0.074</mass>
          <pose>0 0.063 0.020 0 0 0</pose>
          <inertia>
            <ixx>6.50e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>4.77e-05</iyy><iyz>0</iyz>
            <izz>9.30e-05</izz>
          </inertia>
        </inertial>
        <collision name="c_stem">
          <pose>0 0.035 0.020 0 0 0</pose>
          <geometry><box><size>0.025 0.070 0.040</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v_stem">
          <pose>0 0.035 0.020 0 0 0</pose>
          <geometry><box><size>0.025 0.070 0.040</size></box></geometry>
          <material>
            <ambient>0.90 0.80 0.05 1</ambient>
            <diffuse>0.95 0.85 0.10 1</diffuse>
            <specular>0.30 0.25 0.03 1</specular>
          </material>
        </visual>
        <collision name="c_bar">
          <pose>0 0.0825 0.020 0 0 0</pose>
          <geometry><box><size>0.100 0.025 0.040</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v_bar">
          <pose>0 0.0825 0.020 0 0 0</pose>
          <geometry><box><size>0.100 0.025 0.040</size></box></geometry>
          <material>
            <ambient>0.90 0.80 0.05 1</ambient>
            <diffuse>0.95 0.85 0.10 1</diffuse>
            <specular>0.30 0.25 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      ══════════════════════════════════════════════════
      4 个固定分拣区  边长 0.1m  薄板贴地
        zone_A (+0.3, +0.5) 红色
        zone_B (-0.3, +0.5) 蓝色
        zone_C (+0.3, -0.5) 绿色
        zone_D (-0.3, -0.5) 黄色
      ══════════════════════════════════════════════════
    -->

    <!-- 分拣区 A：红色 -->
    <model name="zone_A">
      <static>true</static>
      <pose>0.3 0.5 0.0005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.001</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.001</size></box></geometry>
          <material>
            <ambient>0.85 0.10 0.10 1</ambient>
            <diffuse>0.90 0.15 0.15 1</diffuse>
            <specular>0.20 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 分拣区 B：蓝色 -->
    <model name="zone_B">
      <static>true</static>
      <pose>-0.3 0.5 0.0005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.001</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.001</size></box></geometry>
          <material>
            <ambient>0.10 0.20 0.85 1</ambient>
            <diffuse>0.15 0.30 0.90 1</diffuse>
            <specular>0.05 0.08 0.20 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 分拣区 C：绿色 -->
    <model name="zone_C">
      <static>true</static>
      <pose>0.3 -0.5 0.0005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.001</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.001</size></box></geometry>
          <material>
            <ambient>0.10 0.80 0.15 1</ambient>
            <diffuse>0.15 0.90 0.20 1</diffuse>
            <specular>0.05 0.20 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 分拣区 D：黄色 -->
    <model name="zone_D">
      <static>true</static>
      <pose>-0.3 -0.5 0.0005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.001</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.001</size></box></geometry>
          <material>
            <ambient>0.90 0.85 0.05 1</ambient>
            <diffuse>0.95 0.90 0.10 1</diffuse>
            <specular>0.25 0.20 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
