<?xml version="1.0"?>
<sdf version="1.9">
  <model name="ring_torus">
    <link name="link">
      <inertial>
        <mass>0.054</mass>
        <!-- CoM 在空心圆柱中心 z=h/2=0.020 -->
        <pose>0 0 0.020 0 0 0</pose>
        <inertia>
          <!-- 空心圆柱: Ixx=Iyy=m/12*(3(Ro²+Ri²)+h²), Izz=m/2*(Ro²+Ri²) -->
          <!-- Ro=0.05 Ri=0.03 h=0.04: Ixx=Iyy=5.31e-5  Izz=9.18e-5 -->
          <ixx>5.31e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>5.31e-05</iyy><iyz>0</iyz>
          <izz>9.18e-05</izz>
        </inertia>
      </inertial>

      <!-- 碰撞：精确网格 -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>meshes/ring_torus.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
        </surface>
      </collision>

      <!-- 视觉：同一网格，红色材质 -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/ring_torus.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.75 0.10 0.10 1</ambient>
          <diffuse>0.85 0.15 0.15 1</diffuse>
          <specular>0.30 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
